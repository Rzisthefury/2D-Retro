{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "outFile": "dist/game.js",
    "rootDir": "src",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "files": [
    "src/config.ts",
    "src/core.ts",
    "src/items.ts",
    "src/talents.ts",
    "src/world.ts",
    "src/location.ts",
    "src/superboss.ts",
    "src/music.ts",
    "src/entities.ts",
    "src/travel.ts",
    "src/render.ts",
    "src/main.ts"
  ]
}